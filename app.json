{
  "expo": {
    "name": "Perpetuum",
    "slug": "Perpetuum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "perpetuum",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nomikkh.appPerpetuum"
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a0f2e"
        }
      ],
      "expo-web-browser",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "30ebc57c-987a-437c-9901-33b65ff013f8"
      }
    },
    "owner": "nomikkh",
    "updates": {
      "url": "https://u.expo.dev/30ebc57c-987a-437c-9901-33b65ff013f8"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
