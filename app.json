{
  "expo": {
    "name": "Perpetuum",
    "slug": "Perpetuum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "perpetuum",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.nomikkh.appPerpetuum"
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "react-native-compressor",
      ["expo-media-library",
        {
          "photosPermission": "Allow Cantabile to save lock screen wallpapers.",
          "savePhotosPermission": "Allow Cantabile to save lock screen wallpapers.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "30ebc57c-987a-437c-9901-33b65ff013f8"
      }
    },
    "owner": "nomikkh",
    "updates": {
      "enabled": false
    },
    "runtimeVersion": {
      "policy": "1.0.0"
    }
  }
}
